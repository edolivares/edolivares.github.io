---
import SocialLinks from '../molecules/SocialLinks.astro';
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <p class="copyright">
      Copyright &copy; Edo Olivares
      <time id="currentYear" datetime={String(new Date().getFullYear())}>{new Date().getFullYear()}</time>
    </p>

    <SocialLinks />

    <nav class="quicklinks" aria-label="Enlaces rápidos">
      <ul></ul>
    </nav>
  </div>
</footer>

<script>
  const currentYearElement = document.getElementById('currentYear');
  if (currentYearElement) {
    const currentYear = String(new Date().getFullYear());
    currentYearElement.textContent = currentYear;
    currentYearElement.setAttribute('datetime', currentYear);
  }
</script>

<style>
  .footer {
    width: 100%;
    overflow-x: clip;
    padding: 25px 0;
    background-color: var(--color-surface);
    color: var(--color-ink);
    text-align: center;
  }

  .container {
    display: grid;
    max-width: 1200px;
    align-items: center;
    gap: 20px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .copyright {
    margin: 0;
    font-family: var(--font-heading);
    line-height: 40px;
  }

  .quicklinks ul {
    min-height: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .container {
      grid-template-columns: repeat(3, 1fr);
    }

    .copyright {
      order: 1;
    }

    :global(.footer .social-links) {
      order: 2;
      margin-top: 0;
    }

    .quicklinks {
      order: 3;
    }
  }
</style>
