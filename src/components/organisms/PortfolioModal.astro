---
import type { PortfolioProject } from '../../data/portfolio';

interface Props {
  project: PortfolioProject;
}

const { project } = Astro.props;
const titleId = `${project.id}Label`;
---

<div
  class="modal"
  id={project.id}
  role="dialog"
  aria-labelledby={titleId}
  aria-modal="true"
  aria-hidden="true"
  tabindex="-1"
  data-portfolio-modal
>
  <div class="modal-dialog" data-modal-dialog>
    <div class="modal-content">
      <button class="close-button" type="button" aria-label="Cerrar modal" data-modal-close></button>

      <div class="modal-body">
        <h2 id={titleId}>{project.title}</h2>
        <p class="item-intro">{project.intro}</p>
        <img src={project.image} alt={project.fullAlt} loading="lazy" />

        {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

        {
          project.featureIntro && (
            <p class="feature-intro">{project.featureIntro}</p>
          )
        }

        {
          project.features && (
            <ul class="feature-list">
              {project.features.map((feature) => <li>{feature}</li>)}
            </ul>
          )
        }

        {
          project.liveUrl && (
            <p>
              <strong>Quieres ver el proyecto en vivo?</strong>{' '}
              <a target="_blank" rel="noopener noreferrer" href={project.liveUrl}>
                {project.liveLabel}
              </a>
            </p>
          )
        }

        {
          project.credentials && (
            <ul class="list-inline">
              {project.credentials.map((credential) => <li>{credential}</li>)}
            </ul>
          )
        }

        {project.note && <p>{project.note}</p>}

        <ul class="list-inline">
          {project.meta.map((item) => <li>{item}</li>)}
        </ul>

        <button type="button" class="project-close" data-modal-close>
          Cerrar proyecto
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal {
    position: fixed;
    z-index: 2000;
    inset: 0;
    display: none;
    overflow-x: hidden;
    overflow-y: auto;
    padding: var(--space-6);
    background: rgb(0 0 0 / 0.55);
  }

  .modal.is-open {
    display: block;
  }

  .modal-dialog {
    width: min(100%, 800px);
    min-height: calc(100vh - var(--space-12));
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
  }

  .modal-content {
    position: relative;
    width: 100%;
    min-height: 100%;
    padding: 10px 0 30px 10px;
    border: 0;
    border-radius: 0;
    background: var(--color-surface);
    background-clip: border-box;
    box-shadow: none;
    text-align: center;
  }

  .close-button {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 2rem;
    height: 2rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .close-button::before,
  .close-button::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.5rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
    content: "";
  }

  .close-button::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .close-button::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .modal-body {
    padding: var(--space-12) var(--space-8) var(--space-6);
  }

  h2 {
    margin: 0 0 15px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 3em;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .item-intro {
    margin: 20px 0 30px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-style: italic;
  }

  img {
    width: 100%;
    height: auto;
    margin: 0 auto 30px;
  }

  p {
    margin: 0 0 30px;
  }

  a {
    color: var(--color-brand);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-brand-strong);
    text-decoration: underline;
  }

  .feature-intro {
    margin-bottom: 10px;
    text-align: left;
  }

  .feature-list {
    margin: 0 0 30px;
    padding-left: 50px;
    list-style: initial;
    text-align: left;
  }

  .list-inline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 30px;
    padding: 0;
    list-style: none;
  }

  .project-close {
    padding: 10px 20px;
    border: 1px solid var(--color-brand);
    background: var(--color-brand);
    color: var(--color-surface);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }

  .project-close:hover,
  .project-close:focus {
    border-color: var(--color-brand-strong);
    background: var(--color-brand-strong);
  }

  @media (max-width: 768px) {
    .modal {
      padding: var(--space-3);
    }

    .modal-body {
      padding: var(--space-12) var(--space-4) var(--space-6);
    }

    h2 {
      font-size: 2em;
    }
  }
</style>
