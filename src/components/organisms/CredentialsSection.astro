---
import CredentialCard from '../molecules/CredentialCard.astro';
import { credentials } from '../../data/credentials';

const careerCredentials = credentials.filter((credential) => credential.type === 'career');
const courseCredentials = credentials.filter((credential) => credential.type === 'course');
---

<section id="credentials" class="credentials-section" aria-labelledby="credentials-heading">
  <div class="container">
    <header class="section-header">
      <h2 id="credentials-heading">Certificados</h2>
      <p>Formación continua y certificaciones de cursos y carreras.</p>
    </header>

    <div class="credentials-block">
      <h3>Carreras</h3>
      <div class="credentials-grid">
        {careerCredentials.map((credential) => <CredentialCard credential={credential} />)}
      </div>
    </div>

    <div class="credentials-block">
      <h3>Cursos</h3>
      <div class="credentials-grid">
        {courseCredentials.map((credential) => <CredentialCard credential={credential} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .credentials-section {
    padding: 100px 0;
    background: var(--color-surface);
  }

  .container {
    width: min(100% - 96px, 1080px);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
  }

  .section-header h2 {
    margin: 0 0 15px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-header p {
    margin: 0 0 75px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 16px;
    font-style: italic;
  }

  .credentials-block + .credentials-block {
    margin-top: var(--space-12);
  }

  .credentials-block > h3 {
    margin: 0 0 var(--space-6);
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    text-transform: uppercase;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 576px) {
    .credentials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 992px) {
    .credentials-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .credentials-section {
      padding: 75px 0;
    }

    .container {
      width: min(100% - 44px, 1080px);
    }

    .section-header h2 {
      font-size: 30px;
    }

    .section-header p {
      margin-bottom: 50px;
      font-size: 14px;
    }
  }
</style>
