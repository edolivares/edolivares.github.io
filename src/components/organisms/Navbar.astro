---
import NavLink from '../molecules/NavLink.astro';

const links = [
  { href: '#portfolio', label: 'Portafolio' },
  { href: '#whoami', label: 'Who am I?' },
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experiencia' },
  { href: '#contact', label: 'Contacto' },
];
---

<nav id="mainNav" class="navbar" role="navigation" aria-label="Navegacion principal">
  <div class="container">
    <div class="navbar-header">
      <a class="brand" href="#page-top">Edo Olivares</a>
      <button
        class="toggle"
        type="button"
        aria-controls="navbarCollapse"
        aria-expanded="false"
        aria-label="Toggle navigation"
        data-menu-toggle
      >
        <span class="sr-only">Toggle navigation</span>
        Menu
        <span class="toggle-icon" aria-hidden="true"></span>
      </button>
    </div>

    <div class="collapse" id="navbarCollapse" data-menu-panel>
      <ul class="nav-list" role="menubar">
        <li class="visually-hidden" role="none">
          <a href="#page-top" role="menuitem" tabindex="-1"></a>
        </li>
        {links.map((link) => <NavLink href={link.href} label={link.label} />)}
      </ul>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('[data-menu-panel]');
  const toggle = document.querySelector('[data-menu-toggle]');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  const cleanUrlHash = () => {
    history.replaceState(null, document.title, window.location.pathname + window.location.search);
  };

  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const hash = link.hash;
      const target = hash ? document.getElementById(hash.slice(1)) : null;

      if (
        target &&
        !target.hasAttribute('data-portfolio-modal') &&
        !target.hasAttribute('data-experience-modal') &&
        !link.hasAttribute('data-modal-open') &&
        !link.hasAttribute('data-experience-open')
      ) {
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        cleanUrlHash();
      }

      nav?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const updateNavbar = () => {
    document.getElementById('mainNav')?.classList.toggle('is-affixed', window.scrollY > 50);
  };

  updateNavbar();
  window.addEventListener('scroll', updateNavbar, { passive: true });
</script>

<style>
  .navbar {
    position: fixed;
    z-index: 1000;
    top: 0;
    right: 0;
    left: 0;
    background-color: var(--color-surface-dark);
    border-color: transparent;
  }

  .container {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0 15px;
  }

  .navbar-header {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0 15px;
  }

  .brand {
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    color: var(--color-brand);
    font-family: var(--font-accent);
    font-size: 1.5em;
    line-height: 50px;
    text-align: left;
    text-decoration: none;
  }

  .brand:hover,
  .brand:focus,
  .brand:active {
    color: var(--color-brand);
  }

  .toggle {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 8px 12px;
    border: 2px solid var(--color-brand);
    border-radius: 15px;
    background-color: var(--color-brand);
    color: var(--color-surface);
    font-family: var(--font-heading);
    font-size: 12px;
    text-transform: uppercase;
  }

  .toggle-icon,
  .toggle-icon::before,
  .toggle-icon::after {
    display: block;
    width: 0.875rem;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .toggle-icon {
    position: relative;
  }

  .toggle-icon::before,
  .toggle-icon::after {
    position: absolute;
    left: 0;
    content: "";
  }

  .toggle-icon::before {
    top: -5px;
  }

  .toggle-icon::after {
    top: 5px;
  }

  .collapse {
    display: none;
    margin-top: 10px;
    border-top: 1px solid var(--color-border-strong);
  }

  .collapse.is-open {
    display: block;
  }

  .nav-list {
    margin: 0;
    padding: 15px 0;
    list-style: none;
  }

  .visually-hidden {
    position: absolute;
    display: block;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    clip: rect(0, 0, 0, 0);
    border: 0;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    clip: rect(0, 0, 0, 0);
    border: 0;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .navbar {
      padding: 25px 0;
      border: 0;
      background-color: transparent;
      background-image: radial-gradient(circle, rgb(255 255 255 / 0.1) 1px, transparent 1px);
      background-size: 20px 20px;
      transition: padding 0.3s ease-in-out, background-color 0.3s ease-in-out;
    }

    .navbar.is-affixed {
      padding: 10px 0;
      background-color: var(--color-surface-dark);
      background-image: none;
    }

    .container {
      display: flex;
      max-width: 960px;
      align-items: center;
      justify-content: space-between;
      margin: 0 auto;
    }

    .navbar-header {
      width: auto;
      min-height: 50px;
      padding: 0;
    }

    .brand {
      display: block;
      font-size: 2em;
      transition: all 0.3s ease-in-out;
    }

    .is-affixed .brand {
      font-size: 1.5em;
    }

    .toggle {
      display: none;
    }

    .collapse {
      display: block;
      overflow: visible;
      height: auto;
      margin-top: 0;
      border-top: 0;
    }

    .nav-list {
      display: flex;
      margin: 0;
      padding: 0;
    }
  }

  @media (min-width: 1200px) {
    .container {
      max-width: 1140px;
    }
  }

  @media (min-width: 1400px) {
    .container {
      max-width: 1320px;
    }
  }
</style>
