---
import Button from '../atoms/Button.astro';
---

<header id="page-top" class="hero" role="banner">
  <div class="intro-text">
    <h1 class="intro-lead-in">Bienvenido a mi sitio!</h1>
    <p class="intro-heading">Es un placer conocerte</p>
    <Button href="#about" label="Sobre mi" />
  </div>
</header>

<style>
  .hero {
    background-image: url("/images/header-bg.jpg");
    background-repeat: no-repeat;
    background-attachment: scroll;
    background-position: center center;
    background-size: cover;
    color: var(--color-surface);
    text-align: center;
  }

  .intro-text {
    padding-top: 100px;
    padding-bottom: 50px;
  }

  .intro-lead-in {
    margin: 0 0 25px;
    font-family: var(--font-serif);
    font-size: 22px;
    font-style: italic;
    font-weight: 400;
    line-height: 22px;
    text-transform: none;
  }

  .intro-heading {
    margin: 0 0 25px;
    font-family: var(--font-heading);
    font-size: 50px;
    font-weight: 700;
    line-height: 50px;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .intro-text {
      padding-top: 300px;
      padding-bottom: 200px;
    }

    .intro-lead-in {
      font-size: 40px;
      line-height: 40px;
    }

    .intro-heading {
      margin-bottom: 50px;
      font-size: 75px;
      line-height: 75px;
    }
  }
</style>
