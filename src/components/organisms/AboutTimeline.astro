---
import TimelineItem from '../molecules/TimelineItem.astro';
import { aboutTimeline } from '../../data/about';
---

<section id="about" class="about-section" aria-labelledby="about-heading">
  <div class="container">
    <header class="section-header">
      <h2 id="about-heading">Sobre mi</h2>
      <p>Resumen de mis estudios.</p>
    </header>

    <ol class="timeline">
      {aboutTimeline.map((entry) => <TimelineItem entry={entry} />)}
    </ol>
  </div>
</section>

<style>
  .about-section {
    padding: 100px 0;
    background: var(--color-surface-alt);
  }

  .container {
    width: min(100% - 30px, 1140px);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
  }

  h2 {
    margin: 0 0 15px;
    font-family: var(--font-heading);
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .section-header p {
    margin: 0 0 75px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 16px;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 40px;
    width: 2px;
    margin-left: -1.5px;
    background-color: #9fc5e3;
    content: "";
  }

  @media (min-width: 768px) {
    .timeline::before {
      left: 50%;
    }
  }

  @media (max-width: 767px) {
    .about-section {
      padding: 75px 0;
    }

    h2 {
      font-size: 30px;
    }

    .section-header p {
      margin-bottom: 50px;
      font-size: 14px;
    }
  }
</style>
