---
import type { TimelineEntry } from '../../data/about';

interface Props {
  entry: TimelineEntry;
}

const { entry } = Astro.props;
---

<li class:list={[entry.inverted && 'timeline-inverted']}>
  <div class="timeline-image">
    {
      entry.image ? (
        <img src={entry.image} alt={entry.imageAlt ?? ''} loading="lazy" />
      ) : (
        <h4>
          {entry.callout?.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
        </h4>
      )
    }
  </div>

  {
    (entry.title || entry.subtitle || entry.body) && (
      <div class="timeline-panel">
        <div class="timeline-heading">
          {entry.title && <h3>{entry.title}</h3>}
          {entry.subtitle && <h4>{entry.subtitle}</h4>}
        </div>
        {entry.body && (
          <div class="timeline-body">
            <p>{entry.body}</p>
          </div>
        )}
      </div>
    )
  }
</li>

<style>
  li {
    position: relative;
    min-height: 50px;
    margin-bottom: 50px;
  }

  li::before,
  li::after {
    display: table;
    content: " ";
  }

  li::after {
    clear: both;
  }

  li:last-child {
    margin-bottom: 0;
  }

  .timeline-image {
    position: absolute;
    z-index: 100;
    left: 0;
    display: flex;
    width: 80px;
    height: 80px;
    align-items: center;
    justify-content: center;
    margin-left: 0;
    border: 7px solid #9fc5e3;
    border-radius: var(--radius-full);
    background-color: var(--color-brand);
    color: var(--color-surface);
    text-align: center;
  }

  img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .timeline-image h4 {
    margin: 0;
    padding: 10px;
    color: var(--color-surface);
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    text-align: center;
  }

  .timeline-panel {
    position: relative;
    float: right;
    width: 100%;
    padding: 0 20px 0 100px;
    text-align: left;
  }

  h3,
  h4 {
    margin: 0 0 5px;
    color: inherit;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h4 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    text-transform: none;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-slab);
    font-size: 14px;
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    li {
      min-height: 100px;
      margin-bottom: 100px;
    }

    .timeline-image {
      left: 50%;
      width: 100px;
      height: 100px;
      margin-left: -50px;
    }

    .timeline-image h4 {
      font-size: 13px;
      line-height: 18px;
    }

    .timeline-panel {
      float: left;
      width: 41%;
      padding: 0 20px 20px 30px;
      text-align: right;
    }

    .timeline-inverted .timeline-panel {
      float: right;
      padding: 0 30px 20px 20px;
      text-align: left;
    }
  }

  @media (min-width: 992px) {
    li {
      min-height: 150px;
    }

    .timeline-image {
      width: 150px;
      height: 150px;
      margin-left: -75px;
    }

    .timeline-image h4 {
      font-size: 18px;
      line-height: 26px;
    }

    .timeline-panel,
    .timeline-inverted .timeline-panel {
      padding: 0 20px 20px;
    }
  }

  @media (min-width: 1200px) {
    li {
      min-height: 170px;
    }

    .timeline-image {
      width: 170px;
      height: 170px;
      margin-left: -85px;
    }

    .timeline-panel {
      padding: 0 20px 20px 100px;
    }

    .timeline-inverted .timeline-panel {
      padding: 0 100px 20px 20px;
    }
  }
</style>
