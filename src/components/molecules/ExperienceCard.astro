---
import type { ExperienceItem } from '../../data/experience';
import TechBadge from './TechBadge.astro';

interface Props {
  experience: ExperienceItem;
}

const { experience } = Astro.props;
---

<article class="experience-card">
  <div class="experience-content">
    <div class="company-name">{experience.company}</div>
    <h3>{experience.title}</h3>
    <div class="job-period">{experience.period}</div>

    <div class="tech-preview">
      {experience.previewTech.map((tech) => <TechBadge tech={tech} size="sm" />)}
      {experience.moreCount && <span class="tech-more">+{experience.moreCount} más</span>}
    </div>
  </div>

  <div class="actions">
    <button type="button" data-experience-open={experience.id}>Ver más</button>
  </div>
</article>

<style>
  .experience-card {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: 30px;
    padding: 8px 10px;
    overflow: hidden;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: 0 4px 6px rgb(0 0 0 / 0.1);
    transition: all 0.3s ease;
  }

  .experience-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgb(0 0 0 / 0.15);
  }

  .experience-content {
    padding: 25px;
  }

  .company-name {
    margin-bottom: 5px;
    color: #6c757d;
    font-size: 14px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
  }

  .job-period {
    margin-bottom: 15px;
    color: #6c757d;
    font-size: 14px;
  }

  .tech-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    background: var(--color-surface);
    color: #6c757d;
    font-size: 11px;
    font-weight: 500;
  }

  .actions {
    padding: 0 25px 25px;
    text-align: center;
  }

  button {
    border: 1px solid var(--color-brand);
    border-radius: 25px;
    padding: 10px 20px;
    background: var(--color-brand);
    color: var(--color-surface);
    font-family: var(--font-heading);
    font-weight: 600;
    cursor: pointer;
  }

  button:hover,
  button:focus {
    border-color: var(--color-brand-strong);
    background: var(--color-brand-strong);
  }

  @media (min-width: 992px) {
    .experience-card {
      grid-template-columns: 1fr auto;
      min-height: 120px;
    }

    .actions {
      padding: 25px;
    }
  }

  @media (max-width: 768px) {
    .experience-card {
      margin-bottom: 20px;
      padding: 20px;
    }

    .experience-content,
    .actions {
      padding: 0;
    }

    h3 {
      font-size: 18px;
    }
  }
</style>
