---
import type { Credential } from '../../data/credentials';

interface Props {
  credential: Credential;
}

const { credential } = Astro.props;
const typeLabel = credential.type === 'career' ? 'Carrera' : 'Curso';
const statusLabel = credential.status === 'completed' ? 'Completado' : 'En progreso';
const emptyLabel = credential.status === 'in-progress' ? 'En progreso' : typeLabel;
const hasImage = Boolean(credential.image);
---

<article class:list={['credential-card', credential.type, credential.status]}>
  <div class="preview">
    {
      hasImage ? (
        <a href={credential.image} target="_blank" rel="noopener noreferrer" aria-label={`Abrir certificado ${credential.title}`}>
          <img src={credential.image} alt={`Certificado ${credential.title} de ${credential.issuer}`} loading="lazy" />
        </a>
      ) : (
        <div class="empty-preview" aria-hidden="true">
          <span>{emptyLabel}</span>
        </div>
      )
    }
  </div>

  <div class="content">
    <div class="meta">
      <span>{typeLabel}</span>
      <span class:list={['status', credential.status]}>{statusLabel}</span>
    </div>
    <h3>{credential.title}</h3>
    <p>{credential.program ?? credential.issuer}</p>
  </div>
</article>

<style>
  .credential-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
  }

  .credential-card.in-progress {
    border-style: dashed;
    background: #fffdf8;
  }

  .preview {
    flex: 0 0 auto;
    aspect-ratio: 1.375;
    background: #f3f4f6;
  }

  .preview a {
    display: block;
    width: 100%;
    height: 100%;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .empty-preview {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background: #f6f7f8;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-6);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .status {
    border-radius: var(--radius-full);
    padding: 4px 8px;
    background: #eef6ff;
    color: var(--color-brand);
  }

  .status.in-progress {
    background: #fff7e6;
    color: #a16207;
  }

  h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    line-height: 1.3;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
